{
  "name": "plover-workspace",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "version": "0.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter ./extension dev",
    "build": "pnpm --filter ./extension build",
    "typecheck": "pnpm --filter ./extension typecheck",
    "lint": "pnpm --filter ./extension lint",
    "test": "pnpm --filter ./extension test",
    "test:coverage": "pnpm --filter ./extension run test:coverage"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "extension/**/*.{ts,tsx}": [
      "pnpm --filter ./extension exec eslint --fix",
      "pnpm --filter ./extension exec prettier --write"
    ],
    "extension/**/*.{json,md,yml,yaml,css,html}": [
      "pnpm --filter ./extension exec prettier --write"
    ]
  }
}
