# Copy this file to `app/.env` and fill in real values, then run `pnpm dev`.
# `app/.env` is gitignored — never commit real secrets.

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Model selection (defaults to gemini-2.0-flash; try gemini-1.5-flash if you hit 429 quota limits)
GEMINI_MODEL=gemini-2.0-flash

# Google OAuth 2.0 "Desktop app" client — Google Cloud Console.
# Enable the Google Calendar API; the app requests the calendar.events scope.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
