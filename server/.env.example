# Server Configuration
PORT=3001

# Gemini API Key — single-key mode (backwards compatible).
GEMINI_API_KEY=[GCP_API_KEY]

# Gemini API Keys — comma-separated list for load distribution + failover.
# When set, GEMINI_API_KEYS takes precedence over GEMINI_API_KEY.
# The server round-robins across keys per request and marks any key that
# 429s as "cooling down" for GEMINI_KEY_COOLDOWN_MS before rotating past it.
# GEMINI_API_KEYS=key-one,key-two,key-three

# Optional: cooldown window (in ms) applied to a key after a 429 (default 60000).
# GEMINI_KEY_COOLDOWN_MS=60000

# Optional: Default Gemini Model (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: Simple Shared Secret Token to restrict API access
# If set, clients must include the header: X-Plover-Auth-Token
AUTH_TOKEN=some-secure-random-string
