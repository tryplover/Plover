# Server Configuration
PORT=3000

# Gemini API Key (obtain from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Default Gemini Model (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: Simple Shared Secret Token to restrict API access
# If set, clients must include the header: X-Plover-Auth-Token
# AUTH_TOKEN=some-secure-random-string
