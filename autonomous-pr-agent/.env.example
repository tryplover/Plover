# Gemini API Credentials (obtained from https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub credentials with repository write access (or a Personal Access Token)
GITHUB_TOKEN=your_github_token_here

# The target repository you want this agent to watch, test, and put PRs into
TARGET_REPO=owner/repo_name
TARGET_BRANCH=main
